# --- Slack (from your app's settings at https://api.slack.com/apps) ---
# OAuth & Permissions -> Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# OAuth & Permissions -> User OAuth Token (this is what lets the bot read *your* messages)
SLACK_USER_TOKEN=xoxp-...
# Basic Information -> App-Level Tokens -> generate one with the connections:write scope
SLACK_APP_TOKEN=xapp-...

# Optional: your member ID (Slack profile -> ... -> Copy member ID). Checked against the user token.
OWNER_USER_ID=
# Optional: user groups you're in, so @platform-team style mentions count as addressed to you
OWNER_USERGROUP_IDS=

# --- Claude ---
# Anthropic API (default):
ANTHROPIC_API_KEY=sk-ant-...
# Or Amazon Bedrock with your AWS credentials: set CLAUDE_PROVIDER=bedrock and AWS_REGION.
CLAUDE_PROVIDER=anthropic
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
AWS_REGION=us-east-1

# --- Morning brief ---
TIMEZONE=America/Toronto
BRIEF_TIME=08:30
BRIEF_DAYS=mon-fri
# Optional: channels to also summarize in the brief (decisions, incidents, announcements)
HIGHLIGHT_CHANNELS=#announcements,#eng-incidents

# --- Tracking ---
# Stop showing unanswered items after this many days
MAX_AGE_DAYS=14
# On first start, look back this many days so the first brief isn't empty
BACKFILL_DAYS=3
# Does reacting with an emoji count as responding?
REACTION_COUNTS_AS_REPLY=true
# Track messages from other bots/integrations that @mention you?
INCLUDE_BOT_MESSAGES=false

DB_PATH=briefbot.db
